# ─────────────────────────────────────────────────────────────
# HDFC Expense Tracker Bot — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token

# Your personal Telegram user ID (get it from @userinfobot)
CHAT_ID=123456789

# ── Email (IMAP) ─────────────────────────────────────────────
# Gmail address that receives HDFC Bank alerts
EMAIL_ADDRESS=your_email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_16_char_app_password

# IMAP server settings — defaults work for Gmail
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# How often (seconds) the fetcher polls for new emails
POLL_INTERVAL=60

# ── LLM Provider ─────────────────────────────────────────────
# "groq" (recommended for cloud) or "ollama" (for local/Mac)
LLM_PROVIDER=groq

# Groq Cloud API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# Groq model to use for email parsing
GROQ_MODEL=llama-3.1-8b-instant

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Database ─────────────────────────────────────────────────
# Path to SQLite database file
# Docker: use /data/expenses.db (mapped to db_data volume)
# Local:  use expenses.db (relative to project root)
DB_PATH=/data/expenses.db
